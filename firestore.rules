rules_version = '2';

// Anyone can read the library; only the owner's Google account can change it.
// Replace OWNER_EMAIL with your own before publishing these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'OWNER_EMAIL';
    }
  }
}
