rules_version = '2';

// Replace OWNER_EMAIL with your own before publishing these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'OWNER_EMAIL';
    }

    // The library: anyone can read it, only the owner can change it.
    match /library/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }

    // "This video looks dead" reports from visitors. Anyone can file one per
    // video (the document id is the video id), only the owner can read or
    // clear them. The owner's userscript checks each one before acting on it.
    match /reports/{vid} {
      allow create: if vid.matches('^[A-Za-z0-9_-]{11}$')
        && request.resource.data.keys().hasOnly(['why', 'at'])
        && request.resource.data.why in ['thumb', 'e2', 'e5', 'e100', 'e101', 'e150', 'e153']
        && request.resource.data.at == request.time;
      allow read, delete: if isOwner();
    }
  }
}
